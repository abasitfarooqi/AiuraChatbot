\f5\b0\fs26 \cf0 from flask import Flask, request, jsonify\
from langchain_community.document_loaders import JSONLoader\
from langchain.embeddings import OpenAIEmbeddings\
from langchain.vectorstores import Chroma\
from langchain.llms import Ollama\
from langchain.chains import RetrievalQA\
\
app = Flask(__name__)\
\
# --- Load your JSON data ---\
loader = JSONLoader("data/ngn_data.json")\
docs = loader.load()\
\
# --- Create embeddings + retriever ---\
embedding = OpenAIEmbeddings()  # or use a local one\
vectorstore = Chroma.from_documents(docs, embedding)\
retriever = vectorstore.as_retriever()\
\
# --- Set up model ---\
llm = Ollama(model="llama3")  # Local open-source model\
qa = RetrievalQA.from_chain_type(llm=llm, retriever=retriever)\
\
@app.route("/chatwoot-webhook", methods=["POST"])\
def chatwoot_webhook():\
    payload = request.json\
    question = payload.get("content", "")\
    answer = qa.run(question)\
\
    return jsonify(\{\
        "content": answer or "Sorry, I couldn\'92t find that info. I can connect you to our customer service team now."\
    \})\
\
if __name__ == "__main__":\
    app.run(host="0.0.0.0", port=5000)\
